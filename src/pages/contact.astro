---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`Contact | ${config.site.title}`}
  description="How to contact The Smart Suburbanite about site issues or corrections."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Contact" class="app-prose">
    <p>
      For site issues, correction requests, or feedback about a published guide,
      please open an issue in the public The Smart Suburbanite repository.
    </p>
    <p>
      <a href="https://github.com/natekeem/the-smart-suburbanite/issues">
        Contact The Smart Suburbanite on GitHub
      </a>
    </p>
    <p>
      This site does not currently provide a contact form, comments, newsletter,
      account system, phone number, or physical mailing address.
    </p>
  </Main>
  <Footer />
</Layout>
