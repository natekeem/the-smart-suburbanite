---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`Contact | ${config.site.title}`}
  description="How to contact The Smart Suburbanite about site issues or corrections."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Contact" class="app-prose">
    <p>
      You can use the public issue tracker to report a factual error, broken
      link, outdated subscription or compatibility detail, unclear wording, or
      accessibility problem.
    </p>
    <p>
      <a href="https://github.com/natekeem/the-smart-suburbanite/issues">
        Open a public issue for The Smart Suburbanite
      </a>
    </p>
    <h2>What to include</h2>
    <ul>
      <li>The article or page URL.</li>
      <li>The sentence, claim, link, or accessibility issue in question.</li>
      <li>A supporting source, when one is available.</li>
    </ul>
    <p>
      Substantive correction requests are reviewed against current evidence. A
      request does not guarantee a change when the available evidence does not
      support one, and no response time is promised.
    </p>
    <p>
      This site does not currently provide a contact form, comments, newsletter,
      account system, phone number, or physical mailing address.
    </p>
    <p>
      Read the <a href="/editorial-process/">Editorial Process</a> for more information
      about corrections and updates.
    </p>
  </Main>
  <Footer />
</Layout>
