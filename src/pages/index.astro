---
import { getCollection, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import {
  GUIDE_CATEGORIES,
  START_HERE_SLUGS,
  getGuideMeta,
  getGuideSlug,
  getPostsForCategory,
} from "@/data/guideTaxonomy";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));

const imageOf = (post: CollectionEntry<"posts">) =>
  typeof post.data.ogImage === "string"
    ? post.data.ogImage
    : post.data.ogImage?.src;
const urlOf = (post: CollectionEntry<"posts">) =>
  getPostUrl(post.id, post.filePath, locale);
const dateOf = (post: CollectionEntry<"posts">) =>
  (post.data.modDatetime ?? post.data.pubDatetime).toLocaleDateString(
    "en-US",
    { month: "short", day: "numeric", year: "numeric" }
  );

// Generic tags add no information on a smart-home site, so skip them in chips.
const GENERIC_TAGS = new Set([
  "smart-home",
  "homeowner-guide",
  "beginner-guide",
  "others",
]);
const formatTag = (raw: string) =>
  raw
    .trim()
    .split(/[\s-]+/)
    .map(word =>
      word.toLowerCase() === "wifi"
        ? "Wi-Fi"
        : word.length <= 2
          ? word.toUpperCase()
          : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const chipsOf = (post: CollectionEntry<"posts">) => {
  const meta = getGuideMeta(post);
  const specificTags = post.data.tags
    .filter(
      tag => !GENERIC_TAGS.has(tag.trim().toLowerCase().replace(/\s+/g, "-"))
    )
    .slice(0, 1)
    .map(formatTag);
  return [...specificTags, meta.purpose];
};

const [featuredPost, ...rest] = posts;
const featuredMeta = featuredPost ? getGuideMeta(featuredPost) : null;
const featuredImage = featuredPost ? imageOf(featuredPost) : undefined;
const recentPosts = rest.slice(0, 4);
const moreGuides = rest.slice(4, 10);
const startHerePosts = START_HERE_SLUGS.map(slug =>
  posts.find(post => getGuideSlug(post) === slug)
).filter((post): post is CollectionEntry<"posts"> => Boolean(post));
---

<Layout
  title="The Smart Suburbanite | Practical smart-home guidance"
  description="Calm, practical smart-home guidance for homeowners and renters who want useful routines, reliable setup, and clear trade-offs without product hype."
>
  <Header />
  <main id="main-content" class="sub-home">
    <!-- Intro -->
    <section class="sub-intro app-layout-wide">
      <h1>
        Smart home advice for suburban houses that refuse to pay
        <span class="sub-intro__mark">monthly subscriptions.</span>
      </h1>
      <p class="sub-intro__lede">
        Plain-English guides to locks, doorbells, garage openers, Wi-Fi, and
        sensors &mdash; and what keeps working when the cloud, the app, or the
        free trial doesn&rsquo;t.
      </p>
      <p class="sub-intro__pill">Independent &middot; No sponsored rankings</p>
    </section>

    <!-- Featured story -->
    {
      featuredPost && (
        <section class="app-layout-wide" aria-label="Featured story">
          <article class="sub-feature">
            {featuredImage && (
              <img
                class="sub-feature__img"
                src={featuredImage}
                alt=""
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
              />
            )}
            <div class="sub-feature__panel">
              <span class="sub-chip sub-chip--terracotta">Featured story</span>
              <h2>
                <a href={urlOf(featuredPost)}>{featuredPost.data.title}</a>
              </h2>
              <p class="sub-feature__meta">
                {featuredMeta?.categoryData?.label} &middot; {dateOf(featuredPost)}
              </p>
            </div>
            <aside class="sub-feature__verdict">
              <h3>The 30-second version</h3>
              <p>{featuredPost.data.description}</p>
              <a href={urlOf(featuredPost)}>Read the full guide &rarr;</a>
            </aside>
          </article>
        </section>
      )
    }

    <!-- Guides + sidebar -->
    <div class="sub-columns app-layout-wide">
      <div class="sub-columns__main">
        <section aria-labelledby="recent-heading">
          <div class="sub-heading">
            <h2 id="recent-heading">Recent deep-dive guides</h2>
            <a href={getRelativeLocaleUrl(locale, "posts")}
              >All {posts.length} guides &rarr;</a
            >
          </div>
          <ul class="sub-cards">
            {
              recentPosts.map(post => {
                const image = imageOf(post);
                const meta = getGuideMeta(post);
                return (
                  <li class="sub-card">
                    <a href={urlOf(post)} class="sub-card__link">
                      <div class="sub-card__media">
                        {image && (
                          <img
                            src={image}
                            alt=""
                            width="640"
                            height="400"
                            decoding="async"
                          />
                        )}
                      </div>
                      <div class="sub-card__body">
                        <p class="sub-card__meta">
                          <span>{meta.categoryData?.label}</span>
                          <span aria-hidden="true">&middot;</span>
                          <span>{dateOf(post)}</span>
                        </p>
                        <h3>{post.data.title}</h3>
                        <p class="sub-card__desc">{post.data.description}</p>
                        <div class="sub-card__chips">
                          {chipsOf(post).map(chip => (
                            <span class="sub-chip">{chip}</span>
                          ))}
                        </div>
                      </div>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>

        <section class="sub-more" aria-labelledby="more-heading">
          <div class="sub-heading">
            <h2 id="more-heading">More from the workbench</h2>
            <a href={getRelativeLocaleUrl(locale, "posts")}
              >Browse archive &rarr;</a
            >
          </div>
          <ul class="sub-list">
            {
              moreGuides.map(post => (
                <li>
                  <a href={urlOf(post)}>
                    <span class="sub-list__cat">
                      {getGuideMeta(post).categoryData?.label}
                    </span>
                    <span class="sub-list__title">{post.data.title}</span>
                    <span class="sub-list__date">{dateOf(post)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside class="sub-columns__side" aria-label="Site guide">
        <section
          class="sub-side-card sub-side-card--warm"
          aria-labelledby="start-heading"
        >
          <p class="sub-side-card__eyebrow">Start Here &middot; 4-Step Path</p>
          <h2 id="start-heading">New here? Start with these</h2>
          <ol class="sub-start">
            {
              startHerePosts.map((post, idx) => (
                <li>
                  <a href={urlOf(post)}>
                    <span class="sub-start__num">0{idx + 1}</span>
                    <span class="sub-start__title">{post.data.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <a
            class="sub-side-card__more"
            href={getRelativeLocaleUrl(locale, "start-here")}
            >Follow the full starter roadmap &rarr;</a
          >
        </section>

        <section class="sub-side-card" aria-labelledby="topics-heading">
          <p class="sub-side-card__eyebrow">Browse by Goal</p>
          <h2 id="topics-heading">Popular category guides</h2>
          <ul class="sub-topics">
            {
              GUIDE_CATEGORIES.map(category => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(
                      locale,
                      `categories/${category.slug}`
                    )}
                  >
                    <span>{category.label}</span>
                    <span class="sub-topics__count">
                      {getPostsForCategory(posts, category.slug).length} guides
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="sub-side-card" aria-labelledby="rulebook-heading">
          <p class="sub-side-card__eyebrow">Editorial Standards</p>
          <h2 id="rulebook-heading">The Suburbanite Rulebook</h2>
          <ul class="sub-rules">
            <li>
              <a href="/posts/smart-locks-convenience-security-common-tradeoffs/">
                <strong>1. Cloud-free front doors:</strong> if a lock needs an account
                outage check to open, it doesn&rsquo;t get a key.
              </a>
            </li>
            <li>
              <a href="/posts/video-doorbells-with-no-monthly-fee-what-to-look-for/">
                <strong>2. Zero monthly rent:</strong> don&rsquo;t pay a subscription
                for a doorbell or garage opener you already bought.
              </a>
            </li>
            <li>
              <a href="/posts/smart-lighting-hallways-stairs-nighttime-routines/">
                <strong>3. The 2 a.m. guest test:</strong> a visitor should always
                be able to flip a wall switch and get light.
              </a>
            </li>
          </ul>
          <div class="sub-note-inline">
            <p>
              We focus on compatibility, privacy, upkeep, and realistic setup
              effort &mdash; without claiming fake hands-on testing or paid
              rankings.
            </p>
            <a href={getRelativeLocaleUrl(locale, "editorial-process")}
              >How we research &amp; review guides &rarr;</a
            >
          </div>
        </section>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>
