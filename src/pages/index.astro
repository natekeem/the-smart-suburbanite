---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import {
  GUIDE_CATEGORIES,
  START_HERE_SLUGS,
  getGuideMeta,
  getGuideSlug,
  getPostsForCategory,
} from "@/data/guideTaxonomy";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const startHerePosts = START_HERE_SLUGS.map(slug =>
  posts.find(post => getGuideSlug(post) === slug)
).filter(Boolean);
const featuredPost = posts[0];
const featuredMeta = featuredPost ? getGuideMeta(featuredPost) : null;
const featuredImage = featuredPost
  ? typeof featuredPost.data.ogImage === "string"
    ? featuredPost.data.ogImage
    : featuredPost.data.ogImage?.src
  : undefined;
const latestPosts = posts.slice(1, 7);
---

<Layout
  title="The Smart Suburbanite | Practical smart-home guidance"
  description="Calm, practical smart-home guidance for homeowners and renters who want useful routines, reliable setup, and clear trade-offs without product hype."
>
  <Header />
  <main id="main-content">
    <section class="home-hero">
      <div class="app-layout-wide home-hero__inner">
        <div class="home-hero__copy">
          <div
            class="border-warm/30 bg-warm-soft text-warm mb-3 inline-flex w-fit items-center gap-2 rounded-full border px-3 py-1 text-xs font-bold"
          >
            <span>🏡 No Subscriptions. No Hype. No Junk.</span>
          </div>
          <h1>Smart home gear that actually works for normal households.</h1>
          <p class="home-hero__lede">
            Field-tested advice from a suburban house that refuses to pay
            monthly fees for its own doorbell, garage, or lightbulbs.
          </p>
          <div class="button-row">
            <a
              class="button button--primary"
              href={getRelativeLocaleUrl(locale, "start-here")}
              >Start with the essentials</a
            >
            <a
              class="button button--secondary"
              href={getRelativeLocaleUrl(locale, "posts")}
              >Browse all 19 guides</a
            >
          </div>
        </div>
        {
          featuredPost && (
            <a
              class="featured-story"
              href={getPostUrl(featuredPost.id, featuredPost.filePath, locale)}
              aria-label={`Read the latest guide: ${featuredPost.data.title}`}
            >
              {featuredImage && (
                <div class="featured-story__media">
                  <img
                    src={featuredImage}
                    alt=""
                    width="720"
                    height="405"
                    loading="eager"
                    fetchpriority="high"
                  />
                </div>
              )}
              <div class="featured-story__body">
                <span class="featured-story__label">Latest guide</span>
                <span class="featured-story__category">
                  {featuredMeta?.categoryData?.label} · {featuredMeta?.purpose}
                </span>
                <strong>{featuredPost.data.title}</strong>
                <span class="featured-story__action">Read the guide →</span>
              </div>
            </a>
          )
        }
      </div>
    </section>

    <section
      class="section-block app-layout-wide"
      aria-labelledby="start-heading"
    >
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Editor’s starting points</p>
          <h2 id="start-heading">Start with four useful questions</h2>
          <p>Build context first, then check fit, language, and setup.</p>
        </div>
        <a class="text-link" href={getRelativeLocaleUrl(locale, "start-here")}
          >Follow the Start Here path <span>→</span></a
        >
      </div>
      <ol class="start-path">
        {
          startHerePosts.map(
            (post, index) =>
              post && (
                <li>
                  <span class="start-path__number">0{index + 1}</span>
                  <Card as="div" variant="h3" display="compact" {...post} />
                </li>
              )
          )
        }
      </ol>
    </section>

    <section
      class="section-block section-block--tinted"
      aria-labelledby="goals-heading"
    >
      <div class="app-layout-wide">
        <div class="section-heading">
          <p class="eyebrow">Explore by goal</p>
          <h2 id="goals-heading">Find the guidance that fits the job</h2>
          <p>
            Browse by the decision you are trying to make, not by product hype.
          </p>
        </div>
        <div class="goal-grid">
          {
            GUIDE_CATEGORIES.map((category, index) => {
              const categoryPosts = getPostsForCategory(posts, category.slug);
              return (
                <article class:list={["goal-card", `goal-card--${index + 1}`]}>
                  <p class="goal-card__eyebrow">{category.eyebrow}</p>
                  <h3>{category.label}</h3>
                  <p>{category.description}</p>
                  <ul>
                    {categoryPosts.slice(0, 2).map(post => (
                      <li>
                        <a href={`/posts/${getGuideSlug(post)}/`}>
                          {post.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="text-link" href={`/categories/${category.slug}/`}>
                    View {category.label.toLowerCase()} <span>→</span>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section
      class="section-block app-layout-wide"
      aria-labelledby="latest-heading"
    >
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Recently published</p>
          <h2 id="latest-heading">Latest practical guides</h2>
        </div>
        <a class="text-link" href={getRelativeLocaleUrl(locale, "archives")}
          >See the full archive <span>→</span></a
        >
      </div>
      <ul class="guide-grid">
        {latestPosts.map(post => <Card variant="h3" {...post} />)}
      </ul>
    </section>

    <!-- The Suburbanite Rulebook: Authentic Witty American Suburban Voice -->
    <section
      class="section-block section-block--tinted"
      aria-labelledby="rulebook-heading"
    >
      <div class="app-layout-wide">
        <div
          class="border-accent/20 bg-surface rounded-2xl border-2 p-8 shadow-sm sm:p-12"
        >
          <div class="max-w-3xl">
            <span
              class="bg-accent text-accent-foreground mb-3 inline-block rounded-md px-3 py-1 text-xs font-bold tracking-wider uppercase"
            >
              The Suburbanite Rulebook
            </span>
            <h2
              id="rulebook-heading"
              class="font-display text-heading text-2xl font-bold tracking-tight sm:text-3xl"
            >
              Three rules every smart homeowner learns the hard way
            </h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-3">
              <div class="border-border bg-background/50 rounded-xl border p-5">
                <span class="font-display text-warm text-2xl font-bold"
                  >Rule #1</span
                >
                <p class="text-foreground mt-1 font-bold">
                  If the cloud dies, the door still opens.
                </p>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  Never buy a lock, garage opener, or thermostat that becomes a
                  paperweight when AWS goes down in Virginia.
                </p>
              </div>
              <div class="border-border bg-background/50 rounded-xl border p-5">
                <span class="font-display text-warm text-2xl font-bold"
                  >Rule #2</span
                >
                <p class="text-foreground mt-1 font-bold">
                  The 2 AM Spouse Test.
                </p>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  If someone needs a smartphone app or a Wi-Fi bridge just to
                  turn on the bathroom hallway light at 2 AM, your setup failed.
                </p>
              </div>
              <div class="border-border bg-background/50 rounded-xl border p-5">
                <span class="font-display text-warm text-2xl font-bold"
                  >Rule #3</span
                >
                <p class="text-foreground mt-1 font-bold">
                  Zero Monthly Rent on Hardware.
                </p>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  You already paid $200 for the camera. Refuse to pay $12/month
                  just to see who left the Amazon package on your porch.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <aside
      class="editorial-note app-layout-wide"
      aria-labelledby="editorial-note-heading"
    >
      <p class="eyebrow">How we approach smart-home guidance</p>
      <h2 id="editorial-note-heading">
        Useful fit matters more than a longer feature list.
      </h2>
      <p>
        The Smart Suburbanite focuses on compatibility, privacy, maintenance,
        household access, and realistic setup effort. Guides do not claim
        personal product testing or rank products for everyone.
      </p>
      <a class="text-link" href={getRelativeLocaleUrl(locale, "about")}
        >Read about the editorial approach <span>→</span></a
      >
    </aside>
  </main>
  <Footer />
</Layout>
