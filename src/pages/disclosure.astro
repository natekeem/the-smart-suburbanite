---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`Disclosure | ${config.site.title}`}
  description="Disclosure policy for The Smart Suburbanite."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Disclosure" class="app-prose">
    <p>
      The Smart Suburbanite may use AI assistance for outlining, organization,
      drafting, editing, or quality checks. The human operator reviews the
      important claims, limitations, revisions, and final publication decision.
    </p>
    <p>
      The site does not claim hands-on product testing, ownership, interviews,
      or personal experience unless that work actually occurred and is clearly
      disclosed.
    </p>
    <p>
      At the time of this update, the site has no affiliate links, sponsored
      content, paid product placements, paid product rankings, or display ads.
      If a commercial relationship is introduced later, it will be disclosed
      clearly where it is relevant.
    </p>
    <p>
      For more detail about research and review, read the
      <a href="/editorial-process/">Editorial Process</a>.
    </p>
  </Main>
  <Footer />
</Layout>
