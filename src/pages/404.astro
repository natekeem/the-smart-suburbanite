---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout not-found flex flex-1 items-center justify-center"
  >
    <div class="not-found__inner">
      <p class="eyebrow">A wrong turn</p>
      <h1>That guide is not in this room.</h1>
      <p>
        The address may have changed or the link may be incomplete. Start again
        with a practical path.
      </p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="button button--primary"
      >
        Return home
      </LinkButton>
      <div class="not-found__links">
        <a href="/start-here/">Start Here</a>
        <a href="/posts/">All Guides</a>
        <a href="/search/">Search</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
