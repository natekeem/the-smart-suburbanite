---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import { getGuideMeta } from "@/data/guideTaxonomy";

type Props = {
  variant?: "h2" | "h3";
  display?: "standard" | "compact" | "lead";
  as?: "li" | "div";
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  display = "standard",
  as: Wrapper = "li",
  id,
  data,
  filePath,
} = Astro.props as Props;

const { title, description, ogImage, ...props } = data;
const meta = getGuideMeta(Astro.props as CollectionEntry<"posts">);
const image = typeof ogImage === "string" ? ogImage : ogImage?.src;
---

<Wrapper class:list={["guide-card", `guide-card--${display}`]}>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class="guide-card__link"
    aria-label={`Read ${title}`}
  >
    {
      image && display !== "compact" && (
        <div class="guide-card__media">
          <img src={image} alt="" width="720" height="405" loading="lazy" />
        </div>
      )
    }
    <div class="guide-card__body">
      <div class="guide-card__meta">
        <span>{meta.categoryData?.label}</span>
        <span aria-hidden="true">·</span>
        <span>{meta.purpose}</span>
      </div>
      <Heading transition:name={toTransitionName(title)}>{title}</Heading>
      <p>{description}</p>
      <Datetime {...props} />
      <span class="guide-card__action" aria-hidden="true"
        >Read guide <span>→</span></span
      >
    </div>
  </a>
</Wrapper>
