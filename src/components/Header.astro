---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { features } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const relativePath = stripBase(Astro.url.pathname);
const currentPath = stripLocale(relativePath.replace(/\/$/, "") || "/", locale);
const isActive = (path: string) =>
  path === "/"
    ? currentPath === "/"
    : currentPath === path || currentPath.startsWith(`${path}/`);

const navItems = [
  { href: "/start-here", label: "Start Here" },
  { href: "/categories/beginner-guides", label: "Beginner Guides" },
  { href: "/categories/security-privacy", label: "Security & Privacy" },
  { href: "/categories/maintenance-setup", label: "Maintenance & Setup" },
  { href: "/categories/comfort-convenience", label: "Comfort & Convenience" },
  { href: "/posts", label: "All Guides" },
];
---

<a id="skip-to-content" href="#main-content" class="skip-link">
  {t.a11y.skipToContent}
</a>

<header class="site-header">
  <div class="site-header__top app-layout-wide">
    <a href={getRelativeLocaleUrl(locale, "")} class="brand-lockup">
      <span class="brand-lockup__mark" aria-hidden="true">SS</span>
      <span>
        <strong>The Smart Suburbanite</strong>
        <small>Practical smart-home guidance without the hype.</small>
      </span>
    </a>

    <div class="site-header__actions">
      {
        features.search !== false && (
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="header-icon-button"
            aria-label="Search guides"
            title="Search guides"
          >
            <IconSearch />
          </a>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="header-icon-button theme-button"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="theme-icon theme-icon--moon" />
            <IconSunHigh class="theme-icon theme-icon--sun" />
          </button>
        )
      }
      <button
        id="menu-btn"
        class="header-icon-button menu-button"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="primary-navigation"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconMenuDeep id="menu-icon" />
        <IconX id="close-icon" class="hidden" />
      </button>
    </div>
  </div>

  <nav
    id="primary-navigation"
    class="site-nav app-layout-wide"
    aria-label="Primary navigation"
  >
    <ul>
      {
        navItems.map(item => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, item.href.replace(/^\//, ""))}
              class:list={{ "is-active": isActive(item.href) }}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  function initHeader() {
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    const nav = document.querySelector<HTMLElement>("#primary-navigation");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    if (!button || !nav || !menuIcon || !closeIcon || button.dataset.bound)
      return;

    button.dataset.bound = "true";
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!open));
      button.setAttribute(
        "aria-label",
        open
          ? (button.dataset.labelOpen ?? "Open menu")
          : (button.dataset.labelClose ?? "Close menu")
      );
      nav.classList.toggle("is-open", !open);
      menuIcon.classList.toggle("hidden", !open);
      closeIcon.classList.toggle("hidden", open);
    });
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>
