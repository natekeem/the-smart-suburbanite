---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const ensureTrailingSlash = (url?: string) =>
  url && !url.endsWith("/") ? `${url}/` : url;
const prevHref = ensureTrailingSlash(page.url.prev);
const nextHref = ensureTrailingSlash(page.url.next);
---

{
  page.lastPage > 1 && (
    <nav
      class="pagination"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!prevHref}
        href={prevHref as string}
        rel="nofollow"
        class:list={["select-none", { "opacity-50": !prevHref }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      <span class="pagination__status">
        Page {page.currentPage} of {page.lastPage}
      </span>
      <LinkButton
        disabled={!nextHref}
        href={nextHref as string}
        rel="nofollow"
        class:list={["select-none", { "opacity-50": !nextHref }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
