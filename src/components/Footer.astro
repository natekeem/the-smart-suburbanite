---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import HouseMark from "@/components/HouseMark.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();

const guideLinks = [
  ["Start Here", "start-here"],
  ["All Guides", "posts"],
  ["Beginner Guides", "categories/beginner-guides"],
  ["Security & Privacy", "categories/security-privacy"],
  ["Maintenance & Setup", "categories/maintenance-setup"],
  ["Comfort & Convenience", "categories/comfort-convenience"],
];

const trustLinks = [
  ["About", "about"],
  ["Editorial Process", "editorial-process"],
  ["Contact", "contact"],
  ["Privacy", "privacy"],
  ["Disclosure", "disclosure"],
  ["Browse tags", "tags"],
];
---

<footer
  class:list={["porch-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="porch-footer__band">
    <div class="app-layout-wide porch-footer__grid">
      <div class="porch-footer__brand">
        <a href={getRelativeLocaleUrl(locale, "")} class="porch-footer__wordmark">
          The Smart Suburbanite
        </a>
        <p>
          Plain-English smart-home guides for suburban houses that would rather
          not pay monthly rent on their own doorbell.
        </p>
        <a class="porch-footer__rss" href={getAssetPath("rss.xml")}>RSS feed</a>
      </div>
      <nav aria-label="Guide categories">
        <h2>Explore guides</h2>
        <ul>
          {
            guideLinks.map(([label, href]) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, href)}>{label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Trust and site information">
        <h2>Site information</h2>
        <ul>
          {
            trustLinks.map(([label, href]) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, href)}>{label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="porch-footer__art" aria-hidden="true">
        <HouseMark class="porch-footer__house" />
      </div>
    </div>
  </div>
  <div class="porch-footer__bar">
    <div class="app-layout-wide porch-footer__bar-inner">
      <span>© {currentYear} The Smart Suburbanite</span>
      <span>Independent practical guidance. No fake testing or rankings.</span>
    </div>
  </div>
</footer>
