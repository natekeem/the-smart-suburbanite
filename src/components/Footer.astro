---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();

const guideLinks = [
  ["Start Here", "start-here"],
  ["Beginner Guides", "categories/beginner-guides"],
  ["Security & Privacy", "categories/security-privacy"],
  ["Maintenance & Setup", "categories/maintenance-setup"],
  ["Comfort & Convenience", "categories/comfort-convenience"],
  ["All Guides", "posts"],
];

const trustLinks = [
  ["About", "about"],
  ["Contact", "contact"],
  ["Privacy", "privacy"],
  ["Disclosure", "disclosure"],
];
---

<footer
  class:list={["site-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="app-layout-wide site-footer__grid">
    <div class="site-footer__brand">
      <a href={getRelativeLocaleUrl(locale, "")} class="footer-wordmark">
        The Smart Suburbanite
      </a>
      <p>
        Calm, practical guidance for choosing, setting up, and living with
        smart-home technology.
      </p>
      <a class="footer-rss" href={getAssetPath("rss.xml")}>RSS feed</a>
    </div>
    <nav aria-label="Guide categories">
      <h2>Explore guides</h2>
      <ul>
        {
          guideLinks.map(([label, href]) => (
            <li>
              <a href={getRelativeLocaleUrl(locale, href)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Trust and site information">
      <h2>Site information</h2>
      <ul>
        {
          trustLinks.map(([label, href]) => (
            <li>
              <a href={getRelativeLocaleUrl(locale, href)}>{label}</a>
            </li>
          ))
        }
        <li><a href={getRelativeLocaleUrl(locale, "tags")}>Browse tags</a></li>
      </ul>
    </nav>
  </div>
  <div class="app-layout-wide site-footer__legal">
    <span>Copyright © {currentYear} The Smart Suburbanite.</span>
    <span>Independent practical guidance. No fake testing or rankings.</span>
  </div>
</footer>
