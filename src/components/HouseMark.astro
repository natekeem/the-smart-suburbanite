---
type Props = {
  class?: string;
};

const { class: className = "h-10 w-auto" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 56"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <!-- "Smart" sparkle above the chimney -->
  <g stroke="#D99136" stroke-width="2.2" stroke-linecap="round">
    <line x1="46.5" y1="5" x2="46.5" y2="1.5"></line>
    <line x1="42" y1="6.2" x2="40" y2="3.4"></line>
    <line x1="51" y1="6.2" x2="53" y2="3.4"></line>
  </g>
  <!-- Brick chimney -->
  <rect x="43" y="10" width="7" height="14" fill="#9C4426"></rect>
  <rect x="41.5" y="8.5" width="10" height="3" rx="1" fill="#7A3219"></rect>
  <!-- Craftsman roof with deep eaves -->
  <path d="M2 31 L32 7 L62 31 L56 31 L32 12.5 L8 31 Z" fill="#24523B"></path>
  <path d="M8 31 L32 12.5 L56 31 Z" fill="#E9D9B8"></path>
  <!-- Terracotta house body -->
  <rect x="12" y="29" width="40" height="22" fill="#C85A32"></rect>
  <!-- Gable attic window -->
  <rect
    x="27"
    y="19"
    width="10"
    height="7"
    rx="1"
    fill="#FBF1D9"
    stroke="#24523B"
    stroke-width="1.6"></rect>
  <line x1="32" y1="19" x2="32" y2="26" stroke="#24523B" stroke-width="1.2"
  ></line>
  <!-- Windows with mullions -->
  <g stroke="#24523B" stroke-width="1.6" fill="#FBF1D9">
    <rect x="15.5" y="34" width="9.5" height="8.5" rx="1"></rect>
    <rect x="39" y="34" width="9.5" height="8.5" rx="1"></rect>
  </g>
  <g stroke="#24523B" stroke-width="1.1">
    <line x1="20.25" y1="34" x2="20.25" y2="42.5"></line>
    <line x1="15.5" y1="38.25" x2="25" y2="38.25"></line>
    <line x1="43.75" y1="34" x2="43.75" y2="42.5"></line>
    <line x1="39" y1="38.25" x2="48.5" y2="38.25"></line>
  </g>
  <!-- Front door -->
  <rect x="28" y="35" width="8" height="16" rx="1" fill="#24523B"></rect>
  <circle cx="34" cy="43.5" r="0.9" fill="#D99136"></circle>
  <!-- Porch base -->
  <rect x="7" y="50" width="50" height="3.5" rx="1.75" fill="#24523B"></rect>
</svg>
