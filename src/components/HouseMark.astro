---
type Props = {
  class?: string;
};

const { class: className = "h-8 w-auto" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 52"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <!-- Background subtle warm glow -->
  <rect x="2" y="2" width="60" height="48" rx="8" fill="var(--warm-soft)" stroke="var(--border)" stroke-width="1.5" />
  
  <!-- Craftsman Roof with Overhang -->
  <path
    d="M8 29L32 10l24 19h-6v17a2 2 0 0 1-2 2H16a2 2 0 0 1-2-2V29H8z"
    fill="var(--surface)"
    stroke="var(--accent)"
    stroke-width="2.5"
    stroke-linejoin="round"
  />
  
  <!-- Terracotta Brick Chimney -->
  <path
    d="M41 16V8a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v14.5L41 16z"
    fill="var(--warm)"
  />
  
  <!-- Craftsman Gabled Attic Accent Window -->
  <polygon points="32,15 37,21 27,21" fill="var(--amber)" opacity="0.3" stroke="var(--accent)" stroke-width="1.2" />

  <!-- Craftsman 4-pane Window Left -->
  <rect x="18" y="29" width="8" height="9" rx="1" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
  <line x1="22" y1="29" x2="22" y2="38" stroke="var(--accent)" stroke-width="1" />
  <line x1="18" y1="33.5" x2="26" y2="33.5" stroke="var(--accent)" stroke-width="1" />

  <!-- Craftsman Front Door with Windows -->
  <rect x="30" y="32" width="9" height="16" rx="1" fill="var(--accent)" />
  <circle cx="37" cy="40" r="0.8" fill="var(--amber)" />

  <!-- Craftsman 4-pane Window Right -->
  <rect x="43" y="29" width="8" height="9" rx="1" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.5" />
  <line x1="47" y1="29" x2="47" y2="38" stroke="var(--accent)" stroke-width="1" />
  <line x1="43" y1="33.5" x2="51" y2="33.5" stroke="var(--accent)" stroke-width="1" />

  <!-- Witty Smart Wi-Fi Signal pulsing above the chimney / roof -->
  <circle cx="44.5" cy="4.5" r="1.5" fill="var(--warm)" />
  <path
    d="M40 3a6 6 0 0 1 9 0"
    stroke="var(--accent)"
    stroke-width="1.5"
    stroke-linecap="round"
  />
  <path
    d="M37 0.5a10.5 10.5 0 0 1 15 0"
    stroke="var(--accent)"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-dasharray="2.5 2"
  />
</svg>
