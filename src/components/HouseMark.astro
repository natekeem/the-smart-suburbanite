---
type Props = {
  class?: string;
};

const { class: className = "h-8 w-auto" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <!-- Stylized Craftsman House Body -->
  <path
    d="M6 21L24 6l18 15h-5v15a2 2 0 0 1-2 2H13a2 2 0 0 1-2-2V21H6z"
    fill="var(--surface)"
    stroke="var(--accent)"
    stroke-width="2.5"
    stroke-linejoin="round"></path>
  <!-- Terracotta Chimney with subtle puff -->
  <path
    d="M31 10.5V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v10.5l-6-5z"
    fill="var(--warm, #c85a32)"></path>
  <!-- Craftsman Windows (2 pane) -->
  <rect
    x="14"
    y="22"
    width="6"
    height="7"
    rx="1"
    fill="var(--accent-soft)"
    stroke="var(--accent)"
    stroke-width="1.5"></rect>
  <rect
    x="28"
    y="22"
    width="6"
    height="7"
    rx="1"
    fill="var(--accent-soft)"
    stroke="var(--accent)"
    stroke-width="1.5"></rect>
  <!-- Front Door -->
  <path d="M21 27h6v11h-6z" fill="var(--accent)"></path>
  <!-- Witty Smart Home Antenna / Wi-Fi Beams above roof -->
  <circle cx="24" cy="2.5" r="1.5" fill="var(--warm, #c85a32)"></circle>
  <path
    d="M20.5 2a5 5 0 0 1 7 0"
    stroke="var(--accent)"
    stroke-width="1.5"
    stroke-linecap="round"></path>
  <path
    d="M17.5 -0.5a9 9 0 0 1 13 0"
    stroke="var(--accent)"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-dasharray="2 2"></path>
</svg>
