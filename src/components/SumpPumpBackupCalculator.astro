---
/**
 * SumpPumpBackupCalculator.astro
 * Interactive homeowner sizing & cost calculator comparing water-powered backup
 * sump pumps against 12V AGM battery backup systems during power outages.
 */
---

<div class="sump-calculator not-prose my-10 rounded-2xl border border-border/80 bg-surface/50 p-6 shadow-sm md:p-8" id="sump-calculator">
  <!-- Header -->
  <div class="border-b border-border/60 pb-5">
    <div class="inline-flex items-center gap-2 rounded-full bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-cyan-600 dark:text-cyan-400">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
      </svg>
      <span>Interactive Sizing Tool</span>
    </div>
    <h3 class="mt-3 text-xl font-bold tracking-tight text-foreground md:text-2xl">
      Water-Powered vs. Battery Sump Pump Backup Calculator
    </h3>
    <p class="mt-1 text-sm text-muted-foreground">
      Input your home's municipal water pressure and basement lift height to calculate pumping capacity (GPH), municipal water costs, and battery runtime during an outage.
    </p>
  </div>

  <!-- Form Body -->
  <div class="mt-6 space-y-7">
    <!-- Step 1: Water Source -->
    <div>
      <div class="flex items-center justify-between">
        <label class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
          Step 1: Household Water Source
        </label>
        <span class="text-xs text-muted-foreground">Critical requirement</span>
      </div>

      <div class="mt-2.5 grid grid-cols-1 gap-2.5 sm:grid-cols-2" id="source-group">
        <label class="source-option flex cursor-pointer flex-col rounded-xl border border-accent bg-accent/5 p-3.5 transition-all hover:border-accent">
          <div class="flex items-center gap-2">
            <input type="radio" name="source" value="city" checked class="h-4 w-4 text-accent focus:ring-accent" />
            <span class="text-sm font-semibold text-foreground">City / Municipal Water</span>
          </div>
          <span class="mt-1 text-xs text-muted-foreground">Pressurized by city water towers; stays active during electric grid blackouts</span>
        </label>

        <label class="source-option flex cursor-pointer flex-col rounded-xl border border-border bg-background p-3.5 transition-all hover:border-border/80">
          <div class="flex items-center gap-2">
            <input type="radio" name="source" value="well" class="h-4 w-4 text-accent focus:ring-accent" />
            <span class="text-sm font-semibold text-foreground">Private Well Pump</span>
          </div>
          <span class="mt-1 text-xs text-muted-foreground">Submersible well pump in yard powered by home electricity</span>
        </label>
      </div>
    </div>

    <!-- Step 2: Municipal Water Pressure & Lift Height -->
    <div id="pressure-lift-section" class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <!-- Water Pressure -->
      <div>
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
            Step 2: Water Pressure (PSI)
          </label>
          <span id="pressure-val-display" class="font-mono text-xs font-bold text-accent">60 PSI</span>
        </div>
        <input
          type="range"
          id="pressure-slider"
          min="30"
          max="80"
          step="5"
          value="60"
          class="mt-3 w-full cursor-pointer accent-accent"
        />
        <div class="mt-1 flex justify-between text-[11px] text-muted-foreground">
          <span>30 PSI (Low)</span>
          <span>55–65 PSI (US Suburban Avg)</span>
          <span>80 PSI (Max)</span>
        </div>
      </div>

      <!-- Vertical Lift Height -->
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
          Step 3: Discharge Lift Head
        </label>
        <div class="mt-2.5 grid grid-cols-3 gap-2">
          <label class="lift-option flex cursor-pointer flex-col items-center rounded-lg border border-accent bg-accent/10 p-2.5 text-center transition-colors">
            <input type="radio" name="lift" value="8" checked class="sr-only" />
            <span class="font-mono text-sm font-bold text-foreground">8 ft</span>
            <span class="text-[10px] text-muted-foreground">Standard 8ft Wall</span>
          </label>
          <label class="lift-option flex cursor-pointer flex-col items-center rounded-lg border border-border bg-background p-2.5 text-center transition-colors">
            <input type="radio" name="lift" value="10" class="sr-only" />
            <span class="font-mono text-sm font-bold text-foreground">10 ft</span>
            <span class="text-[10px] text-muted-foreground">Deep Basement</span>
          </label>
          <label class="lift-option flex cursor-pointer flex-col items-center rounded-lg border border-border bg-background p-2.5 text-center transition-colors">
            <input type="radio" name="lift" value="12" class="sr-only" />
            <span class="font-mono text-sm font-bold text-foreground">12 ft</span>
            <span class="text-[10px] text-muted-foreground">Walkout / Grade Rise</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Step 3: Diagnostic Result Card -->
    <div id="sump-result" class="rounded-xl border border-border bg-background p-5 shadow-sm transition-all md:p-6">
      <div id="sump-result-content" class="space-y-4">
        <!-- Rendered dynamically -->
      </div>

      <!-- Action Bar -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-border/60 pt-4 text-xs">
        <button
          type="button"
          id="btn-reset-sump"
          class="inline-flex items-center gap-1.5 font-medium text-muted-foreground hover:text-foreground"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          Reset to default (City water @ 60 PSI, 8ft lift)
        </button>

        <button
          type="button"
          id="btn-copy-sump"
          class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-3 py-1.5 font-medium text-foreground hover:bg-muted/40 transition-colors"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="copy-sump-text">Copy Sizing Summary</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupSumpCalculator() {
    const root = document.getElementById("sump-calculator");
    if (!root) return;

    const sourceInputs = root.querySelectorAll<HTMLInputElement>('input[name="source"]');
    const pressureSlider = root.querySelector<HTMLInputElement>("#pressure-slider");
    const pressureDisplay = root.querySelector<HTMLElement>("#pressure-val-display");
    const liftInputs = root.querySelectorAll<HTMLInputElement>('input[name="lift"]');
    const pressureSection = root.querySelector<HTMLElement>("#pressure-lift-section");
    const resultContent = root.querySelector<HTMLElement>("#sump-result-content");
    const btnReset = root.querySelector<HTMLButtonElement>("#btn-reset-sump");
    const btnCopy = root.querySelector<HTMLButtonElement>("#btn-copy-sump");
    const copyBtnText = root.querySelector<HTMLElement>("#copy-sump-text");

    let lastSizingSummary = "";

    function calculate() {
      const selectedSource = (Array.from(sourceInputs).find(i => i.checked)?.value || "city") as "city" | "well";
      const pressure = parseInt(pressureSlider?.value || "60", 10);
      const lift = parseInt((Array.from(liftInputs).find(i => i.checked)?.value || "8"), 10);

      if (pressureDisplay) {
        pressureDisplay.textContent = `${pressure} PSI`;
      }

      // Source visual style
      sourceInputs.forEach(input => {
        const card = input.closest(".source-option");
        if (card) {
          if (input.checked) {
            card.classList.add("border-accent", "bg-accent/5");
            card.classList.remove("border-border", "bg-background");
          } else {
            card.classList.remove("border-accent", "bg-accent/5");
            card.classList.add("border-border", "bg-background");
          }
        }
      });

      // Lift visual style
      liftInputs.forEach(input => {
        const chip = input.closest(".lift-option");
        if (chip) {
          if (input.checked) {
            chip.classList.add("border-accent", "bg-accent/10");
            chip.classList.remove("border-border", "bg-background");
          } else {
            chip.classList.remove("border-accent", "bg-accent/10");
            chip.classList.add("border-border", "bg-background");
          }
        }
      });

      if (selectedSource === "well") {
        if (pressureSection) pressureSection.style.opacity = "0.4";
        const html = `
          <div class="flex items-start gap-3">
            <div class="rounded-full bg-rose-500/10 p-2 text-rose-600 dark:text-rose-400">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div>
              <span class="inline-block rounded-md bg-rose-500/10 px-2.5 py-0.5 text-xs font-bold text-rose-700 dark:text-rose-300">
                WATER-POWERED BACKUP NOT SUITABLE
              </span>
              <h4 class="mt-1 text-lg font-bold text-foreground">Private Well System Incompatible During Blackout</h4>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                A water-powered sump pump relies entirely on pressurized incoming water to power its venturi vacuum chamber. When power fails in a home on a private well, <strong>the well pump loses electricity and water pressure drops to zero immediately</strong>. A water-powered pump will not evacuate a single drop.
              </p>
              <div class="mt-3 rounded-lg border border-border bg-surface p-3 text-xs text-foreground">
                <span class="font-semibold text-accent">Recommended Solution:</span> You must install a <strong>12V 75Ah–100Ah AGM / Deep-Cycle Battery Backup Sump Pump System</strong> (such as Basement Watchdog Big Dog or Wayne WSS30VN) or power your existing sump pump via a whole-home standby generator / portable inverter.
              </div>
            </div>
          </div>
        `;
        lastSizingSummary = "Water Source: Private Well. Water-powered backup pump is completely INCOMPATIBLE during power outages. 12V AGM battery backup or generator required.";
        if (resultContent) resultContent.innerHTML = html;
        return;
      }

      // City Water Calculations
      if (pressureSection) pressureSection.style.opacity = "1";

      // Base Venturi calculation formula (Standard 3/4" supply line)
      // Base GPH at 8ft: ~22 GPH per PSI. (At 60 PSI @ 8ft = ~1320 GPH).
      let baseGph = Math.round(pressure * 22);
      if (lift === 10) baseGph = Math.round(baseGph * 0.84);
      if (lift === 12) baseGph = Math.round(baseGph * 0.70);

      // Water consumption: 1 gallon of city water pumps approx 2 gallons of groundwater (1:2 ratio)
      const cityWaterPerPumpGallon = 0.5; // gallons consumed per gallon pumped
      const avgCostPerGallon = 0.006; // $6 per 1,000 gallons average US municipal rate
      // Assuming typical storm inflow rate of 600 GPH for 12 hours:
      const stormHours = 12;
      const stormInflowGph = Math.min(baseGph, 600);
      const totalPumpedGallons = stormInflowGph * stormHours;
      const cityWaterUsed = Math.round(totalPumpedGallons * cityWaterPerPumpGallon);
      const estimatedCost = (cityWaterUsed * avgCostPerGallon).toFixed(2);

      const isSufficient = baseGph >= 800;

      const html = `
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <div class="rounded-full ${isSufficient ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-amber-500/10 text-amber-600 dark:text-amber-400'} p-2">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <span class="inline-block rounded-md ${isSufficient ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'bg-amber-500/10 text-amber-700 dark:text-amber-300'} px-2.5 py-0.5 text-xs font-bold">
                ${isSufficient ? 'EXCELLENT EMERGENCY CAPACITY' : 'MARGINAL PUMPING CAPACITY (LOW PSI)'}
              </span>
              <h4 class="mt-1 text-lg font-bold text-foreground">
                ${baseGph.toLocaleString()} GPH Evacuation Rate at ${lift}ft Lift
              </h4>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                At <strong>${pressure} PSI</strong> on municipal water, your system produces <strong>${baseGph.toLocaleString()} gallons per hour</strong> of continuous drainage. Unlike battery backups that die after 5–8 hours, this pump runs indefinitely for days as long as city water mains remain pressurized.
              </p>
            </div>
          </div>

          <!-- Comparison Metrics Grid -->
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 text-xs">
            <div class="rounded-lg border border-border bg-surface p-3">
              <span class="font-bold text-foreground">Pumping Capacity:</span>
              <p class="mt-1 text-base font-extrabold text-cyan-600 dark:text-cyan-400">${baseGph.toLocaleString()} GPH</p>
              <p class="text-[11px] text-muted-foreground mt-0.5">Heavy storm threshold: 800 GPH</p>
            </div>

            <div class="rounded-lg border border-border bg-surface p-3">
              <span class="font-bold text-foreground">12-Hr Storm Water Cost:</span>
              <p class="mt-1 text-base font-extrabold text-foreground">$${estimatedCost}</p>
              <p class="text-[11px] text-muted-foreground mt-0.5">${cityWaterUsed.toLocaleString()} gal city water used ($0.006/gal)</p>
            </div>

            <div class="rounded-lg border border-border bg-surface p-3">
              <span class="font-bold text-foreground">Outage Runtime:</span>
              <p class="mt-1 text-base font-extrabold text-emerald-600 dark:text-emerald-400">Unlimited (Days/Weeks)</p>
              <p class="text-[11px] text-muted-foreground mt-0.5">12V AGM Battery: dies in 5–8 hours</p>
            </div>
          </div>

          <!-- ASSE Plumbing Code Alert -->
          <div class="rounded-lg border border-border bg-surface p-3.5 text-xs space-y-1.5">
            <span class="font-bold text-foreground">Plumbing Code &amp; Hardware Checklist (ASSE 1012):</span>
            <ul class="list-disc pl-4 space-y-1 text-muted-foreground">
              <li><strong>Backflow Prevention:</strong> National Standard Plumbing Code mandates an ASSE 1012 dual-check backflow valve or ASSE 1013 RPZ to prevent sump water from siphoning into household drinking water.</li>
              <li><strong>Dedicated 3/4" Copper Line:</strong> Water-powered pumps require a dedicated 3/4-inch line taken BEFORE the water softener or pressure regulator to prevent flow choke.</li>
              <li><strong>Independent Discharge Pipe:</strong> Do not tee the backup pump into the primary pump's discharge pipe without dual check valves; separate dedicated exterior exits are recommended.</li>
            </ul>
          </div>
        </div>
      `;

      lastSizingSummary = `Water Source: City Water @ ${pressure} PSI, ${lift}ft Lift. Backup Rate: ${baseGph.toLocaleString()} GPH. 12-Hour Storm Water Cost: ~$${estimatedCost}. Runtime: Unlimited. Plumbing: ASSE 1012 dual-check backflow preventer required on 3/4" supply line.`;
      if (resultContent) resultContent.innerHTML = html;
    }

    sourceInputs.forEach(i => i.addEventListener("change", calculate));
    pressureSlider?.addEventListener("input", calculate);
    liftInputs.forEach(i => i.addEventListener("change", calculate));

    if (btnReset) {
      btnReset.addEventListener("click", () => {
        sourceInputs.forEach(i => (i.checked = i.value === "city"));
        if (pressureSlider) pressureSlider.value = "60";
        liftInputs.forEach(i => (i.checked = i.value === "8"));
        calculate();
      });
    }

    if (btnCopy && copyBtnText) {
      btnCopy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            `The Smart Suburbanite Sump Pump Backup Diagnostic:\n` +
            `---------------------------------------------------\n` +
            `${lastSizingSummary}\n\n` +
            `Generated at: https://smartsuburbanite.com/posts/water-powered-sump-pumps-vs-battery-backup-flood-defense/`
          );
          copyBtnText.textContent = "Copied to Clipboard!";
          setTimeout(() => {
            copyBtnText.textContent = "Copy Sizing Summary";
          }, 2500);
        } catch (err) {
          copyBtnText.textContent = "Failed to copy";
        }
      });
    }

    calculate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupSumpCalculator);
  } else {
    setupSumpCalculator();
  }
  document.addEventListener("astro:page-load", setupSumpCalculator);
</script>
